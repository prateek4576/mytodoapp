<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>TaskFlow | Smart ToDo App</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <!-- Google Font -->
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="<%= page %>">

    <!-- Background Decorations -->
    <div class="background-shape shape-one"></div>
    <div class="background-shape shape-two"></div>
    <div class="background-grid"></div>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg modern-navbar">
        <div class="container">

            <!-- Logo -->
            <a
                class="navbar-brand brand-logo"
                href="/"
            >
                <span class="brand-icon">
                    <i class="bi bi-check2-square"></i>
                </span>

                <span>
                    Task<span class="brand-highlight">Flow</span>
                </span>
            </a>

            <!-- Mobile Toggle -->
            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
                aria-controls="navbarNav"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navigation -->
            <div
                class="collapse navbar-collapse"
                id="navbarNav"
            >

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">
                        <a
                            class="nav-link modern-nav-link"
                            href="/"
                        >
                            <i class="bi bi-house"></i>
                            Home
                        </a>
                    </li>

                    <% if (user) { %>

                        <li class="nav-item">
                            <a
                                class="nav-link modern-nav-link"
                                href="/dashboard"
                            >
                                <i class="bi bi-grid-1x2"></i>
                                Dashboard
                            </a>
                        </li>

                    <% } %>

                    <li class="nav-item">
                        <a
                            class="nav-link modern-nav-link"
                            href="https://www.linkedin.com/in/prateek-jangir-software-developer/"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <i class="bi bi-linkedin"></i>
                            LinkedIn
                        </a>
                    </li>

                    <% if (user) { %>

                        <li class="nav-item dropdown">
                            <a
                                class="nav-link user-menu"
                                href="#"
                                role="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                            >

                                <span class="user-avatar">
                                    <i class="bi bi-person-fill"></i>
                                </span>

                                <span class="user-email">
                                    <%= user.email %>
                                </span>

                                <i class="bi bi-chevron-down small"></i>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end modern-dropdown">

                                <li>
                                    <div class="dropdown-user-info">
                                        <div class="small-label">
                                            Signed in as
                                        </div>

                                        <div class="dropdown-email">
                                            <%= user.email %>
                                        </div>
                                    </div>
                                </li>

                                <li>
                                    <hr class="dropdown-divider">
                                </li>

                                <li>
                                    <a
                                        class="dropdown-item logout-item"
                                        href="/logout"
                                    >
                                        <i class="bi bi-box-arrow-right"></i>
                                        Logout
                                    </a>
                                </li>

                            </ul>
                        </li>

                    <% } else { %>

                        <li class="nav-item ms-lg-2">
                            <a
                                href="/login"
                                class="nav-login-btn"
                            >
                                Login
                            </a>
                        </li>

                        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                            <a
                                href="/register"
                                class="nav-register-btn"
                            >
                                Get Started
                            </a>
                        </li>

                    <% } %>

                </ul>

            </div>

        </div>
    </nav>