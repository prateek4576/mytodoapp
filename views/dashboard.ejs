<%- include('partials/header') %>

<main class="dashboard-page">

    <div class="container">

        <!-- Dashboard Header -->

        <div class="dashboard-header">

            <div>

                <div class="dashboard-eyebrow">
                    <i class="bi bi-grid-1x2-fill"></i>
                    Dashboard
                </div>

                <h1>
                    Your Tasks
                </h1>

                <p>
                    Stay organized and make progress one task at a time.
                </p>

            </div>

            <div class="dashboard-user">

                <div class="dashboard-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>
                    <span>Signed in as</span>
                    <strong><%= user.email %></strong>
                </div>

            </div>

        </div>


        <!-- Add Task Card -->

        <section class="add-task-card">

            <div class="add-task-heading">

                <div class="add-task-icon">
                    <i class="bi bi-plus-lg"></i>
                </div>

                <div>
                    <h2>
                        Create a new task
                    </h2>

                    <p>
                        Add something you want to accomplish.
                    </p>
                </div>

            </div>

            <form
                action="/task"
                method="POST"
                class="task-form"
            >

                <div class="task-input-group">

                    <label for="title">
                        Task title
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        placeholder="e.g. Complete project documentation"
                        required
                    >

                </div>

                <div class="task-input-group">

                    <label for="description">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        rows="3"
                        placeholder="Add some details about this task..."
                    ></textarea>

                </div>

                <button
                    type="submit"
                    class="create-task-btn"
                >
                    <i class="bi bi-plus-lg"></i>
                    Add Task
                </button>

            </form>

        </section>


        <!-- Tasks -->

        <section class="tasks-section">

            <div class="tasks-section-header">

                <div>
                    <h2>
                        Your task list
                    </h2>

                    <p>
                        <%= tasks.length %>
                        <%= tasks.length === 1 ? 'task' : 'tasks' %> total
                    </p>
                </div>

            </div>


            <% if (tasks.length === 0) { %>

                <!-- Empty State -->

                <div class="empty-state">

                    <div class="empty-icon">
                        <i class="bi bi-clipboard-check"></i>
                    </div>

                    <h3>
                        No tasks yet
                    </h3>

                    <p>
                        You're all caught up! Create your first task
                        to start getting things done.
                    </p>

                    <a
                        href="#title"
                        class="empty-action"
                    >
                        <i class="bi bi-plus-lg"></i>
                        Create your first task
                    </a>

                </div>

            <% } else { %>

                <div class="task-grid">

                    <% tasks.forEach(function(task, index) { %>

                        <article
                            class="task-card <%= task.completed ? 'task-completed' : '' %>"
                        >

                            <div class="task-card-top">

                                <div class="task-number">
                                    <%= String(index + 1).padStart(2, '0') %>
                                </div>

                                <% if (task.completed) { %>

                                    <span class="status-badge completed">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Completed
                                    </span>

                                <% } else { %>

                                    <span class="status-badge pending">
                                        <i class="bi bi-clock-fill"></i>
                                        Pending
                                    </span>

                                <% } %>

                            </div>

                            <div class="task-card-content">

                                <h3>
                                    <%= task.title %>
                                </h3>

                                <p>
                                    <%= task.description || 'No description provided.' %>
                                </p>

                            </div>

                            <div class="task-card-footer">

                                <div class="task-created">
                                    <i class="bi bi-calendar3"></i>

                                    <% if (task.createdAt) { %>
                                        <%= new Date(task.createdAt).toLocaleDateString() %>
                                    <% } else { %>
                                        Recently
                                    <% } %>

                                </div>

                                <div class="task-actions">

                                    <a
                                        href="/task/edit/<%= task.id %>"
                                        class="task-action edit-action"
                                        title="Edit task"
                                    >
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <% if (task.completed === true) { %>

                                        <a
                                            href="/task/delete/<%= task.id %>"
                                            class="task-action delete-action"
                                            title="Delete task"
                                            onclick="return confirm('Are you sure you want to delete this task?');"
                                        >
                                            <i class="bi bi-trash3"></i>
                                        </a>

                                    <% } %>

                                </div>

                            </div>

                        </article>

                    <% }) %>

                </div>

            <% } %>

        </section>

    </div>

</main>

<%- include('partials/footer') %>